NODE_ENV=development
PORT=3010

# Turso libSQL (cloud) - optional. Leave blank to use local SQLite.
# TURSO_DATABASE_URL=libsql://YOUR-DB-NAME-ORG.turso.io
# TURSO_AUTH_TOKEN=YOUR_TOKEN

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

DB_PATH=./data/sports.db

BCRYPT_SALT_ROUNDS=10
CORS_ORIGINS=http://localhost:8081,http://10.0.2.2:8081
